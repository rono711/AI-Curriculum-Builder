oDr-lRMWFvwmFMSeV2bnKZ6TYI6gE-MmCM/edit#gid=756338189"},"filtersUI":{"values":[{"lookupColumn":"Status","lookupValue":"NEW"}]},"options":{}},"type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[-256,-160],"id":"68bf98b2-d595-416b-a709-aabdf34811e9","name":"Read Build Queue","credentials":{"googleSheetsOAuth2Api":{"id":"vjwstK77vCBgv7wf","name":"Google Sheets account"}}},{"parameters":{"documentId":{"__rl":true,"value":"1Groe5A4JEwaj09i6Z0jTO6Djjj60278yv2ua2B7J23Y","mode":"id"},"sheetName":{"__rl":true,"value":695964045,"mode":"list","cachedResultName":"Learning areas","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1Groe5A4JEwaj09i6Z0jTO6Djjj60278yv2ua2B7J23Y/edit#gid=695964045"},"filtersUI":{"values":[{"lookupColumn":"Subject","lookupValue":"={{$node[\"Read Build Queue\"].json[\"Subject\"]}}"},{"lookupColumn":"Level","lookupValue":"={{ $json.Year }}"}]},"options":{}},"type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[-80,-160],"id":"b5b27a3b-12f2-40e3-ab9e-8afabdf7b777","name":"Read Curriculum","credentials":{"googleSheetsOAuth2Api":{"id":"vjwstK77vCBgv7wf","name":"Google Sheets account"}}},{"parameters":{"jsCode":"/*****************************************************************************************\n *\n *  AI Curriculum Builder Platform\n *  ----------------------------------------------------------------------------\n *  File:\n *      Build_AI_Lesson_Packages_v1.js\n *\n *  Version:\n *      1.0.0\n *\n *  Author:\n *      Mohammad Hassan\n *\n *  Platform:\n *      n8n\n *\n *  Purpose:\n *      Converts Australian Curriculum rows into AI Lesson Packages.\n *\n *      Workflow:\n *\n *      Curriculum Workbook\n *              │\n *              ▼\n *      Read Curriculum\n *              │\n *              ▼\n *      Curriculum Parser\n *              │\n *              ▼\n *      AI Lesson Packages\n *\n *  Output:\n *\n *      One AI Lesson Package per curriculum elaboration.\n *\n *  Downstream Workflows:\n *\n *      Workbook Builder\n *      Prompt Builder\n *      Gamma Builder\n *      Moodle Publisher\n *      NotebookLM Builder\n *\n *********************************************************************************/\n\n\n/*****************************************************************************************\n *\n * CONFIGURATION\n *\n *********************************************************************************/\n\nconst CONFIG = {\n\n    VERSION: \"1.0.0\",\n\n    CURRICULUM_VERSION: \"Australian Curriculum v9\",\n\n    DEFAULT_STATUS: \"NEW\",\n\n    DEFAULT_LESSON_STATUS: \"Draft\",\n\n    DEFAULT_DIFFICULTY: \"\",\n\n    DEFAULT_ESTIMATED_TIME: \"\",\n\n    SUBJECT_PREFIX_LENGTH: 3\n\n};\n\n\n\n/*****************************************************************************************\n *\n * READ BUILD JOB\n *\n *********************************************************************************/\n\nconst buildJob =\n    $(\"Read Build Queue\")\n        .first()\n        .json;\n\n\n\n/*****************************************************************************************\n *\n * READ CURRICULUM ROWS\n *\n *********************************************************************************/\n\nconst curriculumRows =\n    $input\n        .all()\n        .map(item => item.json);\n\n\n\n/*****************************************************************************************\n *\n * HELPER FUNCTIONS\n *\n *********************************************************************************/\n\n\nfunction get(row, ...keys) {\n\n    for (const key of keys) {\n\n        if (\n            row[key] !== undefined &&\n            row[key] !== null &&\n            String(row[key]).trim() !== \"\"\n        ) {\n\n            return row[key];\n\n        }\n\n    }\n\n    return \"\";\n\n}\n\n\n\n/*****************************************************************************************\n *\n * Remove HTML\n * Remove extra spaces\n *\n *********************************************************************************/\n\nfunction cleanText(value) {\n\n    return String(value || \"\")\n\n        .replace(/<[^>]*>/g, \" \")\n\n        .replace(/\\s+/g, \" \")\n\n        .trim();\n\n}\n\n\n\n/*****************************************************************************************\n *\n * Convert text into uppercase slug\n *\n * Example\n *\n * Mathematics\n *\n * becomes\n *\n * MATHEMATICS\n *\n *********************************************************************************/\n\nfunction slug(value) {\n\n    return cleanText(value)\n\n        .toUpperCase()\n\n        .replace(/[^A-Z0-9]+/g, \"_\")\n\n        .replace(/^_+|_+$/g, \"\");\n\n}\n\n\n\n/*****************************************************************************************\n *\n * Convert\n *\n * Year 5\n *\n * into\n *\n * Y5\n *\n *********************************************************************************/\n\nfunction yearShort(year) {\n\n    const y = cleanText(year);\n\n    const match = y.match(/(\\d+)/);\n\n    if (match) {\n\n        return `Y${match[1]}`;\n\n    }\n\n    return y;\n\n}\n\n\n\n/*****************************************************************************************\n *\n * Detect elaboration rows\n *\n * Example\n *\n * AC9M5N01_E2\n *\n *********************************************************************************/\n\nfunction isElaborationCode(code) {\n\n    return /_E\\d+$/i.test(cleanText(code));\n\n}\n\n\n\n/*****************************************************************************************\n *\n * Parent curriculum code\n *\n * AC9M5N01_E4\n *\n * becomes\n *\n * AC9M5N01\n *\n *********************************************************************************/\n\nfunction baseCode(code) {\n\n    return cleanText(code)\n\n        .replace(/_E\\d+$/i, \"\");\n\n}\n\n/*****************************************************************************************\n *\n * Find nearest inherited value\n *\n * Used for:\n *  - Strand\n *  - Sub-strand\n *  - Pathway\n *  - Sequence\n *\n *********************************************************************************/\n\nfunction findInheritedValue(currentIndex, fieldNames) {\n\n    for (let i = currentIndex; i >= 0; i--) {\n\n        const row = curriculumRows[i];\n\n        for (const field of fieldNames) {\n\n            const value = cleanText(row[field]);\n\n            if (value !== \"\") {\n                return value;\n            }\n\n        }\n\n    }\n\n    return \"\";\n\n}\n\n/*****************************************************************************************\n *\n * Topic title\n *\n * Initial version:\n *\n * Uses first sentence of elaboration.\n *\n * Version 2\n * will use AI.\n *\n *********************************************************************************/\n\nfunction topicFromElaboration(elaboration, content, code) {\n\n    const text =\n        cleanText(\n            elaboration ||\n            content ||\n            code ||\n            \"Lesson Topic\"\n        );\n\n    const sentence =\n        text\n            .split(/[.;:]/)[0]\n            .split(\",\")[0]\n            .trim();\n\n    const words =\n        sentence.split(\" \");\n\n    if (words.length > 8) {\n\n        return words.slice(0, 8).join(\" \") + \"...\";\n\n    }\n\n    return sentence;\n\n}\n\n\n\n/*****************************************************************************************\n *\n * Topic ID\n *\n * Example\n *\n * MAT_Y5_AC9M5N01_E2_L05\n *\n *********************************************************************************/\n\nfunction makeTopicId(\n    subject,\n    year,\n    code,\n    lessonNo\n) {\n\n    return [\n\n        slug(subject)\n            .slice(0, CONFIG.SUBJECT_PREFIX_LENGTH),\n\n        yearShort(year),\n\n        slug(code),\n\n        `L${String(lessonNo).padStart(2, \"0\")}`\n\n    ].join(\"_\");\n\n}\n\n\n\n/*****************************************************************************************\n *\n * Create lookup table\n *\n * Used for finding parent curriculum rows.\n *\n *********************************************************************************/\n\nconst rowByCode = new Map();\n\nfor (const row of curriculumRows) {\n\n    const code =\n        cleanText(\n            get(\n                row,\n                \"Code\",\n                \"Curriculum Code\"\n            )\n        );\n\n    if (code) {\n\n        rowByCode.set(\n            code,\n            row\n        );\n\n    }\n\n}\n\n/*****************************************************************************************\n *\n * BUILD AI LESSON PACKAGES\n *\n *********************************************************************************/\n\nconst lessonPackages = [];\n\nlet lessonNumber = 1;\n\n\n/*****************************************************************************************\n *\n * LOOP THROUGH CURRICULUM\n *\n *********************************************************************************/\n\nfor (const row of curriculumRows) {\n\n    const curriculumCode =\n        cleanText(\n            get(\n                row,\n                \"Code\",\n                \"Curriculum Code\"\n            )\n        );\n\n    /*\n    ----------------------------------------------------\n    Ignore headings\n\n    Keep only\n\n    AC9...._E1\n\n    AC9...._E2\n\n    etc.\n    ----------------------------------------------------\n    */\n\n    if (!isElaborationCode(curriculumCode)) {\n        continue;\n    }\n\n    /*\n    ----------------------------------------------------\n    Parent curriculum row\n    ----------------------------------------------------\n    */\n\n    const parentCode =\n        baseCode(curriculumCode);\n\n    const parentRow =\n        rowByCode.get(parentCode) || {};\n\n\n    /*\n    ----------------------------------------------------\n    Subject\n    ----------------------------------------------------\n    */\n\n    const subject =\n        cleanText(\n\n            buildJob.Subject ||\n\n            get(\n                row,\n                \"Subject\",\n                \"Learning Area\"\n            ) ||\n\n            get(\n                parentRow,\n                \"Subject\",\n                \"Learning Area\"\n            )\n\n        );\n\n\n    /*\n    ----------------------------------------------------\n    Learning Area\n    ----------------------------------------------------\n    */\n\n    const learningArea =\n        cleanText(\n\n            get(\n                row,\n                \"Learning Area\"\n            ) ||\n\n            get(\n                parentRow,\n                \"Learning Area\"\n            ) ||\n\n            subject\n\n        );\n\n\n    /*\n    ----------------------------------------------------\n    Year\n    ----------------------------------------------------\n    */\n\n    const year =\n        cleanText(\n\n            buildJob.Year ||\n\n            get(\n                row,\n                \"Level\",\n                \"Year\"\n            ) ||\n\n            get(\n                parentRow,\n                \"Level\",\n                \"Year\"\n            )\n\n        );\n\n\n    /*\n    ----------------------------------------------------\n    Pathway\n    ----------------------------------------------------\n    */\n\n    const pathway =\n    findInheritedValue(\n\n        curriculumRows.indexOf(row),\n\n        [\"Pathway\"]\n\n    );\n\n\n    /*\n    ----------------------------------------------------\n    Sequence\n    ----------------------------------------------------\n    */\n\n    const sequence =\n    findInheritedValue(\n\n        curriculumRows.indexOf(row),\n\n        [\"Sequence\"]\n\n    );\n\n\n    /*\n    ----------------------------------------------------\n    Strand\n    ----------------------------------------------------\n    */\n\n   const strand =\n    findInheritedValue(\n\n        curriculumRows.indexOf(row),\n\n        [\"Strand\"]\n\n    );\n\n\n    /*\n    ----------------------------------------------------\n    Sub-strand\n    ----------------------------------------------------\n    */\n\n    const subStrand =\n         findInheritedValue(\n\n        curriculumRows.indexOf(row),\n\n        [\n\n            \"Sub-strand\",\n\n            \"Sub-Strand\",\n\n            \"Sub Strand\",\n\n            \"SubStrand\"\n\n        ]\n\n    );\n\n\n    /*\n    ----------------------------------------------------\n    Parent Content Description\n    ----------------------------------------------------\n    */\n\n    const contentDescription =\n        cleanText(\n\n            get(\n                parentRow,\n                \"Content Description\",\n                \"Content D\",\n                \"Content\"\n            ) ||\n\n            get(\n                parentRow,\n                \"Topics\",\n                \"Topic\"\n            )\n\n        );\n\n\n    /*\n    ----------------------------------------------------\n    Elaboration\n    ----------------------------------------------------\n    */\n\n    const elaboration =\n        cleanText(\n\n            get(\n                row,\n                \"Elaboration\"\n            )\n\n        );\n\n\n    /*\n    ----------------------------------------------------\n    Lesson Topic\n    ----------------------------------------------------\n    */\n\n    const topic =\n        topicFromElaboration(\n\n            elaboration,\n\n            contentDescription,\n\n            curriculumCode\n\n        );\n\n\n    /*\n    ----------------------------------------------------\n    IDs\n    ----------------------------------------------------\n    */\n\n    const topicId =\n        makeTopicId(\n\n            subject,\n\n            year,\n\n            curriculumCode,\n\n            lessonNumber\n\n        );\n\n\n    const lessonPackageId =\n        \"LP_\" + topicId;\n\n\n    /*\n    ----------------------------------------------------\n    Build AI Lesson Package\n    ----------------------------------------------------\n    */\n\n    lessonPackages.push({\n\n        topicId,\n\n        lessonPackageId,\n\n        subject,\n\n        learningArea,\n\n        year,\n\n        curriculumCode,\n\n        parentCode,\n\n        lessonNumber,\n\n        pathway,\n\n        sequence,\n\n        strand,\n\n        subStrand,\n\n        contentDescription,\n\n        elaboration,\n\n        topic\n\n    });\n\n\n    lessonNumber++;\n\n}\n\n/*****************************************************************************************\n *\n * CONVERT LESSON PACKAGES TO n8n ITEMS\n *\n *********************************************************************************/\n\nreturn lessonPackages.map(pkg => {\n\n    const now = new Intl.DateTimeFormat('sv-SE', {\n      timeZone: 'Australia/Melbourne',\n      year: 'numeric',\n      month: '2-digit',\n      day: '2-digit',\n      hour: '2-digit',\n      minute: '2-digit',\n      second: '2-digit',\n      hour12: false\n    }).format(new Date()).replace(',', '');\n\n    return {\n\n        json: {\n\n            /*\n            ============================================================\n            IDENTIFIERS\n            ============================================================\n            */\n\n            \"Topic ID\": pkg.topicId,\n\n            \"Lesson Package ID\": pkg.lessonPackageId,\n\n            /*\n            ============================================================\n            CURRICULUM\n            ============================================================\n            */\n\n            \"Subject\": pkg.subject,\n\n            \"Learning Area\": pkg.learningArea,\n\n            \"Year\": pkg.year,\n\n            \"Curriculum Code\": pkg.curriculumCode,\n\n            \"Parent Code\": pkg.parentCode,\n\n            \"Lesson Number\": pkg.lessonNumber,\n\n            \"Pathway\": pkg.pathway,\n\n            \"Sequence\": pkg.sequence,\n\n            \"Strand\": pkg.strand,\n\n            \"Sub-strand\": pkg.subStrand,\n\n            \"Content Description\": pkg.contentDescription,\n\n            \"Elaboration\": pkg.elaboration,\n\n            /*\n            ============================================================\n            LESSON\n            ============================================================\n            */\n\n            \"Topic\": pkg.topic,\n\n            \"Difficulty\": CONFIG.DEFAULT_DIFFICULTY,\n\n            \"Estimated Time\": CONFIG.DEFAULT_ESTIMATED_TIME,\n\n            /*\n            ============================================================\n            BUILD INFORMATION\n            ============================================================\n            */\n\n            \"Source Spreadsheet ID\":\n                buildJob[\"Source Spreadsheet ID\"] || \"\",\n\n            \"Curriculum Version\":\n                CONFIG.CURRICULUM_VERSION,\n\n            \"Build ID\":\n                buildJob[\"Build ID\"] || \"\",\n            \n          \"Build Subject\":\n                buildJob[\"Subject\"] || \"\",\n\n            \"Build Year\":\n                buildJob[\"Year\"] || \"\",/*\n            ============================================================\n            STATUS\n            ============================================================\n            */\n\n            \"Lesson Status\":\n                CONFIG.DEFAULT_LESSON_STATUS,\n\n            \"Version\":\n                CONFIG.VERSION,\n\n            \"Status\":\n                CONFIG.DEFAULT_STATUS,\n\n            /*\n            ============================================================\n            TIMESTAMPS\n            ============================================================\n            */\n\n            \"Created\":\n                now,\n\n            \"Updated\":\n                \"\"\n\n        }\n\n    };\n\n});\n\n\n/*************************************************************************